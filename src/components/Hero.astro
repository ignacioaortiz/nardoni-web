---
---

<section id="inicio" class="relative text-white py-20 md:py-28 overflow-hidden">
  <!-- Imagen de fondo con blur -->
  <div class="absolute inset-0 scale-105">
    <img
      src="/foto-0.jpeg"
      alt=""
      class="w-full h-full object-cover"
      style="filter: blur(3px);"
    />
  </div>

  <!-- Overlay multicapa: oscurece + tinte navy corporativo -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#0d1b2a]/85 via-[#1a3a5c]/70 to-[#0d1b2a]/80"></div>
  <!-- Franja inferior opaca para anclar el contenido -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#0d1b2a]/60 to-transparent"></div>

  <!-- Contenido -->
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <!-- Badge corporativo -->
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white/90 text-xs font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-accent inline-block"></span>
        Neuquén · Cipolletti · Patagonia
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-5 leading-tight" style="text-shadow: 0 4px 20px rgba(0,0,0,0.5);">
        Mecánica General<br/>
        <span class="text-accent/90">de Confianza</span>
      </h1>

      <p class="text-lg md:text-xl mb-4 text-white/85 leading-relaxed max-w-xl" style="text-shadow: 0 2px 10px rgba(0,0,0,0.4);">
        Soluciones integrales para la reparación de tu vehículo con repuestos de calidad y profesionales certificados.
      </p>

      <p class="text-base text-white/65 italic mb-10" style="text-shadow: 0 2px 8px rgba(0,0,0,0.3);">
        "Comprometidos con hacer el trabajo de forma correcta, siempre."
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="https://wa.me/542995808012"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-dark text-white px-8 py-4 rounded-md font-semibold transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-base"
        >
          Contactanos
        </a>
        <a
          href="#contacto"
          class="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm border border-white/25 hover:bg-white/20 text-white px-8 py-4 rounded-md font-semibold transition-all text-base"
        >
          Conocé más
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 opacity-50">
    <span class="text-xs uppercase tracking-widest text-white">Scroll</span>
    <svg class="w-4 h-4 text-white animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
