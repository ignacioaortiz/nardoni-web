---
const features = [
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>`,
    title: "Precios Competitivos",
    description: "Acceso directo a proveedores premium que nos permite ofrecerte los mejores precios del mercado sin resignar calidad."
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>`,
    title: "Atención Flexible",
    description: "Adaptamos nuestros horarios para atender tus necesidades. Disponibilidad amplia para que tu vehículo no espere."
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
    </svg>`,
    title: "Profesionales Certificados",
    description: "Equipo especializado con años de experiencia en el sector automotriz. Diagnóstico preciso, trabajo garantizado."
  }
];
---

<section id="nosotros" class="py-24 bg-bg-light scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-accent mb-3">¿Por qué elegirnos?</span>
      <h2 class="text-3xl md:text-4xl font-bold text-text-dark mb-4">
        Compromiso con la excelencia
      </h2>
      <div class="w-16 h-1 bg-accent mx-auto mb-5 rounded-full"></div>
      <p class="text-text-light max-w-xl mx-auto leading-relaxed">
        Más de una década brindando soluciones integrales con la mejor calidad y atención personalizada en Neuquén y Cipolletti.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-md transition-all border border-gray-100 hover:border-primary/20 group">
          <div class="w-14 h-14 rounded-lg bg-primary/8 flex items-center justify-center text-primary mb-6 group-hover:bg-primary group-hover:text-white transition-all" set:html={feature.icon} />
          <h3 class="text-lg font-bold text-text-dark mb-3">{feature.title}</h3>
          <p class="text-text-light text-sm leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
